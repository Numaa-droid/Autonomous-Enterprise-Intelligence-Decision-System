# Copy to .env and fill in, then `chmod 600 .env`. Never commit .env.
# Use a strong password, e.g. the output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
AEIDS_DB_PASSWORD=change-me
# Must use the same password as AEIDS_DB_PASSWORD.
AEIDS_DATABASE_URL=postgresql+psycopg://aeids:change-me@127.0.0.1:5432/aeids

# Host names the API answers to; others are refused (DNS rebinding, D-034). JSON list.
# AEIDS_ALLOWED_HOSTS=["127.0.0.1", "localhost", "::1"]
# Public demo (D-039): true refuses every change except search and questions.
# AEIDS_READ_ONLY=false
# Owner key (D-040): lets you upload/delete in the demo from the console (Reports -> Owner? Unlock).
# At least 16 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
# AEIDS_OWNER_KEY=

# Original uploaded files (LocalStore, D-005).
AEIDS_STORAGE_ROOT=./storage
# Upload size limit in bytes (default 100 MB).
AEIDS_MAX_UPLOAD_BYTES=104857600

# OpenRouter (D-001, D-002). Chunk text and prompts are sent to OpenRouter.
AEIDS_OPENROUTER_API_KEY=
AEIDS_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# embedding batches sent to OpenRouter at the same time (1-16)
AEIDS_EMBEDDING_CONCURRENCY=8
# one OpenRouter provider for all embeddings (vectors differ between providers, D-023)
AEIDS_EMBEDDING_PROVIDER=nebius
AEIDS_EMBEDDING_ALLOW_FALLBACKS=false
AEIDS_LLM_MODEL=qwen/qwen3.8-flash
# hidden reasoning before each reply: off (default; faster, same answers), low, medium, high, model_default
AEIDS_LLM_REASONING=off
AEIDS_LLM_TIMEOUT_SECONDS=45
# Workflow agents: auto (LLM agents when the key above is set), llm, or stub (no model calls)
AEIDS_AGENT_MODE=auto

# TableLens (tablelens/app.py) parses uploaded PDFs (D-019).
AEIDS_TABLELENS_URL=http://127.0.0.1:8000
# queue: uploads start a background job (run: python -m aeids.worker) · inline · off
AEIDS_JOBS_MODE=queue

# Run tracing (D-022) and where ./start.sh writes logs for the console's Logs page
AEIDS_TRACING_ENABLED=true
AEIDS_LOG_DIR=./logs

# Services (docker compose up -d)
AEIDS_QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud only (deployment): its API key. Leave empty for the local Qdrant.
AEIDS_QDRANT_API_KEY=
AEIDS_REDIS_URL=redis://127.0.0.1:6379/0
